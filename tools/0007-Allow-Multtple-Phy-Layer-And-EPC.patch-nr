From 0794b5629c7d3a15b10dbadec4df477e548f89ac Mon Sep 17 00:00:00 2001
From: Domingo Dirutigliano <me@domy.sh>
Date: Sat, 2 May 2026 23:16:15 +0200
Subject: [PATCH] allowing more nr phy layers with more epc auto-addressing

---
 helper/nr-helper.cc                    |  4 ++++
 helper/nr-helper.h                     |  3 ++-
 helper/nr-no-backhaul-epc-helper.cc    | 31 ++++++++++++++++++--------
 helper/nr-no-backhaul-epc-helper.h     |  3 +++
 helper/nr-point-to-point-epc-helper.cc |  7 ++++--
 5 files changed, 36 insertions(+), 12 deletions(-)

diff --git a/helper/nr-helper.cc b/helper/nr-helper.cc
index 0daf5d53..857bd301 100644
--- a/helper/nr-helper.cc
+++ b/helper/nr-helper.cc
@@ -61,7 +61,11 @@ NS_LOG_COMPONENT_DEFINE("NrHelper");
 
 NS_OBJECT_ENSURE_REGISTERED(NrHelper);
 
+uint16_t NrHelper::m_cellIdCounter = 1;
+uint64_t NrHelper::m_imsiCounter = 1;
+
 NrHelper::NrHelper()
+    : m_useIdealRrc(true)
 {
     NS_LOG_FUNCTION(this);
     m_channelFactory.SetTypeId(MultiModelSpectrumChannel::GetTypeId());
diff --git a/helper/nr-helper.h b/helper/nr-helper.h
index e1086c1b..ff842018 100644
--- a/helper/nr-helper.h
+++ b/helper/nr-helper.h
@@ -1083,7 +1083,8 @@ class NrHelper : public Object
     ObjectFactory m_fhControlFactory;
     ObjectFactory m_initialAttachmentFactory; //!< initial attachment factory
 
-    uint16_t m_cellIdCounter{1}; //!< CellId Counter
+    static uint16_t m_cellIdCounter; //!< CellId Counter
+    static uint64_t m_imsiCounter;   //!< IMSI Counter
 
     Ptr<NrEpcHelper> m_nrEpcHelper{nullptr};                 //!< Ptr to the EPC helper (optional)
     Ptr<BeamformingHelperBase> m_beamformingHelper{nullptr}; //!< Ptr to the beamforming helper
diff --git a/helper/nr-no-backhaul-epc-helper.cc b/helper/nr-no-backhaul-epc-helper.cc
index f2fe49b7..74dcac2d 100644
--- a/helper/nr-no-backhaul-epc-helper.cc
+++ b/helper/nr-no-backhaul-epc-helper.cc
@@ -42,6 +42,8 @@ NrNoBackhaulEpcHelper::NrNoBackhaulEpcHelper()
       m_s5LinkDelay(Seconds(0)),
       m_s5LinkMtu(3000)
 {
+    static uint32_t epcIndex = 0;
+    m_epcIndex = epcIndex++;
     NS_LOG_FUNCTION(this);
 }
 
@@ -55,15 +57,22 @@ NrNoBackhaulEpcHelper::NotifyConstructionCompleted()
     // since we use point-to-point links for links between the core network nodes,
     // we use a /30 subnet which can hold exactly two addresses
     // (remember that net broadcast and null address are not valid)
-    m_x2Ipv4AddressHelper.SetBase("12.0.0.0", "255.255.255.252");
-    m_s11Ipv4AddressHelper.SetBase("13.0.0.0", "255.255.255.252");
-    m_s5Ipv4AddressHelper.SetBase("14.0.0.0", "255.255.255.252");
+    std::stringstream x2, s11, s5, ue, ue6;
+    x2 << "12." << m_epcIndex << ".0.0";
+    s11 << "13." << m_epcIndex << ".0.0";
+    s5 << "14." << m_epcIndex << ".0.0";
+    ue << "7." << m_epcIndex << ".0.0";
+    ue6 << "7777:f00" << std::hex << m_epcIndex << "::";
 
-    // we use a /8 net for all UEs
-    m_uePgwAddressHelper.SetBase("7.0.0.0", "255.0.0.0");
+    m_x2Ipv4AddressHelper.SetBase(x2.str().c_str(), "255.255.255.252");
+    m_s11Ipv4AddressHelper.SetBase(s11.str().c_str(), "255.255.255.252");
+    m_s5Ipv4AddressHelper.SetBase(s5.str().c_str(), "255.255.255.252");
+
+    // we use a /16 net for all UEs
+    m_uePgwAddressHelper.SetBase(ue.str().c_str(), "255.255.0.0");
 
     // we use a /64 IPv6 net all UEs
-    m_uePgwAddressHelper6.SetBase("7777:f00d::", Ipv6Prefix(64));
+    m_uePgwAddressHelper6.SetBase(Ipv6Address(ue6.str().c_str()), Ipv6Prefix(64));
 
     // Create PGW, SGW and MME nodes
     m_pgw = CreateObject<Node>();
@@ -81,7 +90,7 @@ NrNoBackhaulEpcHelper::NotifyConstructionCompleted()
     Ipv6StaticRoutingHelper ipv6RoutingHelper;
     Ptr<Ipv6StaticRouting> pgwStaticRouting =
         ipv6RoutingHelper.GetStaticRouting(m_pgw->GetObject<Ipv6>());
-    pgwStaticRouting->AddNetworkRouteTo("7777:f00d::", Ipv6Prefix(64), Ipv6Address("::"), 1, 0);
+    pgwStaticRouting->AddNetworkRouteTo(Ipv6Address(ue6.str().c_str()), Ipv6Prefix(64), Ipv6Address("::"), 1, 0);
 
     // create TUN device implementing tunneling of user data over GTP-U/UDP/IP in the PGW
     m_tunDevice = CreateObject<VirtualNetDevice>();
@@ -666,7 +675,9 @@ NrNoBackhaulEpcHelper::SetupRemoteHost(std::optional<std::string> dataRate,
     Ipv4InterfaceContainer internetIpIfaces = ipv4h.Assign(internetDevices);
     Ptr<Ipv4StaticRouting> remoteHostStaticRouting4 =
         ipv4RoutingHelper.GetStaticRouting(remoteHost->GetObject<Ipv4>());
-    remoteHostStaticRouting4->AddNetworkRouteTo(Ipv4Address("7.0.0.0"), Ipv4Mask("255.0.0.0"), 1);
+    std::stringstream ue;
+    ue << "7." << m_epcIndex << ".0.0";
+    remoteHostStaticRouting4->AddNetworkRouteTo(Ipv4Address(ue.str().c_str()), Ipv4Mask("255.255.0.0"), 1);
     return std::make_pair(remoteHost, internetIpIfaces.GetAddress(1, 0));
 }
 
@@ -710,8 +721,10 @@ NrNoBackhaulEpcHelper::SetupRemoteHost6(std::optional<std::string> dataRate,
     Ipv6StaticRoutingHelper ipv6RoutingHelper;
     Ptr<Ipv6StaticRouting> remoteHostStaticRouting =
         ipv6RoutingHelper.GetStaticRouting(remoteHost->GetObject<Ipv6>());
+    std::stringstream ue6;
+    ue6 << "7777:f00" << std::hex << m_epcIndex << "::";
     remoteHostStaticRouting
-        ->AddNetworkRouteTo("7777:f00d::", Ipv6Prefix(64), internetIpIfaces.GetAddress(0, 1), 1, 0);
+        ->AddNetworkRouteTo(Ipv6Address(ue6.str().c_str()), Ipv6Prefix(64), internetIpIfaces.GetAddress(0, 1), 1, 0);
     return std::make_pair(remoteHost, internetIpIfaces.GetAddress(1, 1));
 }
 
diff --git a/helper/nr-no-backhaul-epc-helper.h b/helper/nr-no-backhaul-epc-helper.h
index 3867b8c7..aa967014 100644
--- a/helper/nr-no-backhaul-epc-helper.h
+++ b/helper/nr-no-backhaul-epc-helper.h
@@ -107,6 +107,9 @@ class NrNoBackhaulEpcHelper : public NrEpcHelper
                                         const Ptr<NrQosRule>& rule,
                                         const NrQosFlow& flow) const;
 
+  protected:
+    uint32_t m_epcIndex;
+
   private:
     /**
      * helper to assign IPv4 addresses to UE devices as well as to the TUN device of the SGW/PGW
diff --git a/helper/nr-point-to-point-epc-helper.cc b/helper/nr-point-to-point-epc-helper.cc
index 9c77b14a..61ec44a8 100644
--- a/helper/nr-point-to-point-epc-helper.cc
+++ b/helper/nr-point-to-point-epc-helper.cc
@@ -38,8 +38,11 @@ NrPointToPointEpcHelper::NotifyConstructionCompleted()
     // since we use point-to-point links for the backhaul links,
     // we use a /30 subnet which can hold exactly two addresses
     // (remember that net broadcast and null address are not valid)
-    m_s1uIpv4AddressHelper.SetBase("10.0.0.0", "255.255.255.252");
-    m_s1apIpv4AddressHelper.SetBase("11.0.0.0", "255.255.255.252");
+    std::stringstream s1u, s1ap;
+    s1u << "10." << m_epcIndex << ".0.0";
+    s1ap << "11." << m_epcIndex << ".0.0";
+    m_s1uIpv4AddressHelper.SetBase(s1u.str().c_str(), "255.255.255.252");
+    m_s1apIpv4AddressHelper.SetBase(s1ap.str().c_str(), "255.255.255.252");
 }
 
 NrPointToPointEpcHelper::~NrPointToPointEpcHelper()
-- 
2.50.1 (Apple Git-155)

