From 096e68b329773cc75dc411f8e0631ebaafa9c579 Mon Sep 17 00:00:00 2001
From: Domingo Dirutigliano <me@domy.sh>
Date: Sat, 18 Apr 2026 00:59:41 +0200
Subject: [PATCH] PATCH: skip channel matrix assert for nr radio map creation

---
 src/spectrum/model/three-gpp-channel-model.cc | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/src/spectrum/model/three-gpp-channel-model.cc b/src/spectrum/model/three-gpp-channel-model.cc
index 9d58d24a2..085dbbb99 100644
--- a/src/spectrum/model/three-gpp-channel-model.cc
+++ b/src/spectrum/model/three-gpp-channel-model.cc
@@ -2413,13 +2413,12 @@ ThreeGppChannelModel::NewChannelMatrixNeeded(const uint64_t channelMatrixKey,
     {
         NS_LOG_DEBUG("Generate a new channel matrix. Matrix not found.");
         // This function call is needed because of the API of PhasedArrayModel/UniformPlannarArray,
-        // which assumes that this function is called when the channel is created
-        const bool channelNeedsToBeCreated = aAntenna->IsChannelOutOfDate(bAntenna);
-        NS_ASSERT_MSG(channelNeedsToBeCreated,
-                      "This assert is to ensure that this code stays aligned with "
-                      "PhasedArrayModel/UniformPlannarArray "
-                      "API, which expects that this function is being called on the initial "
-                      "channel matrix creation.");
+        // which assumes that this function is called when the channel is created.
+        // We do not assert on the result because multiple ThreeGppChannelModel instances
+        // (e.g. during REM map generation or for different BWPs) might evaluate the same
+        // antenna pair, causing exactly one of them to observe true and the rest false.
+        [[maybe_unused]] const bool channelNeedsToBeCreated =
+            aAntenna->IsChannelOutOfDate(bAntenna);
         return true;
     }
     else
