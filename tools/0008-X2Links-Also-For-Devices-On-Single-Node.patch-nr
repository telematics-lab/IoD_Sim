-    gnb1X2->AddX2Interface(gnb1CellId, gnb1X2Address, std::vector<uint16_t>{gnb2CellId}, gnb2X2Address);
-    gnb2X2->AddX2Interface(gnb2CellId, gnb2X2Address, std::vector<uint16_t>{gnb1CellId}, gnb1X2Address);
