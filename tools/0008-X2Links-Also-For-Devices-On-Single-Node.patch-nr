@@ -222,6 +222,16 @@ class NrQosRule : public SimpleRefCount<NrQosRule>
      */
     uint8_t GetQfi() const;
 
+    /**
+     * @brief Equality operator.
+     * @param other the other rule to compare with
+     * @return true if equal
+     */
+    bool operator==(const NrQosRule& other) const
+    {
+        return (m_precedence == other.m_precedence && m_filters == other.m_filters);
+    }
+
   private:
     std::list<PacketFilter> m_filters; ///< packet filter list
     uint8_t m_numFilters;              ///< number of packet filters applied to this QoS rule
