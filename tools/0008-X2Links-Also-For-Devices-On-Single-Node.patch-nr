+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvHandoverRequestAck(params);
         }
         else // messageType == NrEpcX2Header::UnsuccessfulOutcome
         {
@@ -261,7 +293,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
             NS_LOG_LOGIC("cause = " << params.cause);
             NS_LOG_LOGIC("criticalityDiagnostics = " << params.criticalityDiagnostics);
 
-            m_x2SapUser->RecvHandoverPreparationFailure(params);
+            NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+            NS_ASSERT_MSG(sapUser,
+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvHandoverPreparationFailure(params);
         }
     }
     else if (procedureCode == NrEpcX2Header::LoadIndication)
@@ -280,7 +315,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
 
             NS_LOG_LOGIC("cellInformationList size = " << params.cellInformationList.size());
 
-            m_x2SapUser->RecvLoadInformation(params);
+            NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+            NS_ASSERT_MSG(sapUser,
+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvLoadInformation(params);
         }
     }
     else if (procedureCode == NrEpcX2Header::SnStatusTransfer)
@@ -308,7 +346,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
             NS_LOG_LOGIC("targetCellId = " << params.targetCellId);
             NS_LOG_LOGIC("erabsList size = " << params.erabsSubjectToStatusTransferList.size());
 
-            m_x2SapUser->RecvSnStatusTransfer(params);
+            NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+            NS_ASSERT_MSG(sapUser,
+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvSnStatusTransfer(params);
         }
     }
     else if (procedureCode == NrEpcX2Header::UeContextRelease)
@@ -329,7 +370,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
             NS_LOG_LOGIC("oldGnbUeX2apId = " << params.oldGnbUeX2apId);
             NS_LOG_LOGIC("newGnbUeX2apId = " << params.newGnbUeX2apId);
 
-            m_x2SapUser->RecvUeContextRelease(params);
+            NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+            NS_ASSERT_MSG(sapUser,
+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvUeContextRelease(params);
         }
     }
     else if (procedureCode == NrEpcX2Header::ResourceStatusReporting)
@@ -354,7 +398,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
             NS_LOG_LOGIC(
                 "cellMeasurementResultList size = " << params.cellMeasurementResultList.size());
 
-            m_x2SapUser->RecvResourceStatusUpdate(params);
+            NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+            NS_ASSERT_MSG(sapUser,
+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvResourceStatusUpdate(params);
         }
     }
     else if (procedureCode == NrEpcX2Header::HandoverCancel)
@@ -381,7 +428,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
             NS_LOG_LOGIC("targetCellId = " << params.targetCellId);
             NS_LOG_LOGIC("cause = " << params.cause);
 
-            m_x2SapUser->RecvHandoverCancel(params);
+            NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+            NS_ASSERT_MSG(sapUser,
+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvHandoverCancel(params);
         }
     }
     else
@@ -414,7 +464,9 @@ NrEpcX2::RecvFromX2uSocket(Ptr<Socket> socket)
     params.gtpTeid = gtpu.GetTeid();
     params.ueData = packet;
 
-    m_x2SapUser->RecvUeData(params);
+    NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+    NS_ASSERT_MSG(sapUser, "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+    sapUser->RecvUeData(params);
 }
 
 //
diff --git a/model/nr-epc-x2.h b/model/nr-epc-x2.h
index 7ae09df9..49707847 100644
--- a/model/nr-epc-x2.h
+++ b/model/nr-epc-x2.h
@@ -107,9 +107,19 @@ class NrEpcX2 : public Object
 
     /**
      * @param s the X2 SAP User to be used by this EPC X2 entity
+     * (legacy single-cell path; routes all incoming messages to s)
      */
     void SetEpcX2SapUser(NrEpcX2SapUser* s);
 
+    /**
+     * @brief Register the X2 SAP User for a specific local cell.
+     *        Call this instead of the single-arg overload when multiple gNBs
+     *        share one NrEpcX2 object (same node, different beams/cell IDs).
+     * @param cellId the local cell ID
+     * @param s the X2 SAP User (i.e., the gNB RRC) for that cell
+     */
+    void SetEpcX2SapUser(uint16_t cellId, NrEpcX2SapUser* s);
+
     /**
      * @return the X2 SAP Provider interface offered by this EPC X2 entity
      */
@@ -194,8 +204,8 @@ class NrEpcX2 : public Object
      */
     virtual void DoSendHandoverCancel(NrEpcX2SapProvider::HandoverCancelParams params);
 
-    NrEpcX2SapUser* m_x2SapUser;         ///< X2 SAP user
-    NrEpcX2SapProvider* m_x2SapProvider; ///< X2 SAP provider
+    std::map<uint16_t, NrEpcX2SapUser*> m_x2SapUsers; ///< X2 SAP users, keyed by local cell ID
+    NrEpcX2SapProvider* m_x2SapProvider;              ///< X2 SAP provider
 
   private:
     /**
@@ -210,6 +220,15 @@ class NrEpcX2 : public Object
      */
     std::map<Ptr<Socket>, Ptr<NrX2CellInfo>> m_x2InterfaceCellIds;
 
+    /**
+     * @brief Look up the SAP user for the given local cell ID.
+     *        If a cell-specific entry exists it is returned; otherwise the
+     *        wildcard entry (key 0, set by the legacy single-arg overload) is used.
+     * @param localCellId the local cell ID of the receiving gNB
+     * @return the corresponding NrEpcX2SapUser*, or nullptr if not found
+     */
+    NrEpcX2SapUser* GetX2SapUser(uint16_t localCellId) const;
+
     /**
      * UDP ports to be used for the X2-C interface
      */
diff --git a/model/nr-gnb-rrc.cc b/model/nr-gnb-rrc.cc
index f5f416d4..53780bdb 100644
--- a/model/nr-gnb-rrc.cc
+++ b/model/nr-gnb-rrc.cc
@@ -429,18 +429,31 @@ void
 NrUeManager::SetupDataRadioBearer(NrQosFlow flow,
                                   uint8_t qfi,
                                   uint32_t gtpTeid,
-                                  Ipv4Address transportLayerAddress)
+                                  Ipv4Address transportLayerAddress,
+                                  uint8_t drbid)
 {
     NS_LOG_FUNCTION(this << (uint32_t)m_rnti);
 
+    // Check if bearer with this QFI already exists
+    for (const auto& [id, info] : m_drbMap)
+    {
+        if (info->m_qosFlowIdentity == qfi && qfi != 0)
+        {
+            NS_LOG_WARN("Bearer for QFI " << (uint32_t)qfi
+                                          << " already exists, skipping SetupDataRadioBearer");
+            return;
+        }
+    }
+
     Ptr<NrDataRadioBearerInfo> drbInfo = CreateObject<NrDataRadioBearerInfo>();
-    uint8_t drbid = AddDataRadioBearerInfo(drbInfo);
+    drbid = AddDataRadioBearerInfo(drbInfo, drbid);
     uint8_t lcid = nr::Drbid2Lcid(drbid);
     uint8_t qosFlowId = nr::Drbid2Qfi(drbid);
     NS_ASSERT_MSG(qfi == 0 || qosFlowId == qfi,
                   "QFI mismatch (" << (uint32_t)qosFlowId << " != " << (uint32_t)qfi
                                    << ", the assumption that ID are allocated in the same "
-                                      "way by MME and RRC is not valid any more");
+                                      "way by MME and RRC is not valid any more. DRBID was "
+                                   << (uint32_t)drbid);
     drbInfo->m_qosFlow = flow;
     drbInfo->m_qosFlowIdentity = qfi;
     drbInfo->m_drbIdentity = drbid;
@@ -1497,24 +1510,36 @@ NrUeManager::BuildHoCancelMsg()
 }
 
 uint8_t
-NrUeManager::AddDataRadioBearerInfo(Ptr<NrDataRadioBearerInfo> drbInfo)
+NrUeManager::AddDataRadioBearerInfo(Ptr<NrDataRadioBearerInfo> drbInfo, uint8_t drbid)
 {
     NS_LOG_FUNCTION(this);
     const uint8_t MAX_DRB_ID = 32;
