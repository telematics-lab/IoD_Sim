diff --git a/model/nr-epc-x2.cc b/model/nr-epc-x2.cc
index 373a83ee..70ae0c0d 100644
--- a/model/nr-epc-x2.cc
+++ b/model/nr-epc-x2.cc
@@ -104,7 +104,33 @@ void
 NrEpcX2::SetEpcX2SapUser(NrEpcX2SapUser* s)
 {
     NS_LOG_FUNCTION(this << s);
-    m_x2SapUser = s;
+    // Legacy path: store under cell ID 0 as a fallback wildcard.
+    // Any cell-specific entry (added via the cellId overload) takes priority.
+    m_x2SapUsers[0] = s;
+}
+
+void
+NrEpcX2::SetEpcX2SapUser(uint16_t cellId, NrEpcX2SapUser* s)
+{
+    NS_LOG_FUNCTION(this << cellId << s);
+    m_x2SapUsers[cellId] = s;
+}
+
+NrEpcX2SapUser*
+NrEpcX2::GetX2SapUser(uint16_t localCellId) const
+{
+    // Prefer exact cell ID match; fall back to wildcard entry (key 0)
+    auto it = m_x2SapUsers.find(localCellId);
+    if (it != m_x2SapUsers.end())
+    {
+        return it->second;
+    }
+    auto fb = m_x2SapUsers.find(0);
+    if (fb != m_x2SapUsers.end())
+    {
+        return fb->second;
+    }
+    return nullptr;
 }
 
 NrEpcX2SapProvider*
@@ -212,7 +238,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
             NS_LOG_LOGIC("mmeUeS1apId = " << params.mmeUeS1apId);
             NS_LOG_LOGIC("cellsInfo->m_localCellId = " << cellsInfo->m_localCellIds.at(0));
 
-            m_x2SapUser->RecvHandoverRequest(params);
+            NrEpcX2SapUser* sapUser = GetX2SapUser(cellsInfo->m_localCellIds.at(0));
+            NS_ASSERT_MSG(sapUser,
+                          "Missing SAP user for cellId " << cellsInfo->m_localCellIds.at(0));
+            sapUser->RecvHandoverRequest(params);
         }
         else if (messageType == NrEpcX2Header::SuccessfulOutcome)
         {
@@ -237,7 +266,10 @@ NrEpcX2::RecvFromX2cSocket(Ptr<Socket> socket)
             NS_LOG_LOGIC("sourceCellId = " << params.sourceCellId);
             NS_LOG_LOGIC("targetCellId = " << params.targetCellId);
 
-            m_x2SapUser->RecvHandoverRequestAck(params);
