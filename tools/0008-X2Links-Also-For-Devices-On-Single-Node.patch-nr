--- a/model/nr-qos-rule-classifier.cc
+++ b/model/nr-qos-rule-classifier.cc
@@ -44,6 +44,9 @@ NrQosRuleClassifier::Add(Ptr<NrQosRule> rule, uint8_t qfi)
     // Set the QFI in the rule for later retrieval during classification
     rule->SetQfi(qfi);
 
+    // If a rule with this QFI already exists, remove it first to avoid duplicates
+    Delete(qfi);
+
     // Extract the rule precedence and insert into multimap
     uint8_t precedence = rule->GetPrecedence();
     m_qosRuleMap.insert({precedence, rule});
diff --git a/model/nr-qos-rule.h b/model/nr-qos-rule.h
