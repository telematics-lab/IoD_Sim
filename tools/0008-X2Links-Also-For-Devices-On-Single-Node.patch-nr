From 8aa10f8636ca2dae4733a9fad28934504e9ef81a Mon Sep 17 00:00:00 2001
From: Domingo Dirutigliano <me@domy.sh>
Date: Sat, 9 May 2026 11:43:46 +0200
Subject: [PATCH] X2 links also for netdevices in the same node

---
 helper/nr-epc-helper.h              |  8 ++++
 helper/nr-helper.cc                 | 29 +++++++++++-
 helper/nr-helper.h                  |  2 +
 helper/nr-no-backhaul-epc-helper.cc | 54 ++++++++++++++--------
 helper/nr-no-backhaul-epc-helper.h  |  1 +
 model/nr-epc-x2.cc                  | 72 +++++++++++++++++++++++++----
 model/nr-epc-x2.h                   | 23 ++++++++-
 model/nr-gnb-rrc.cc                 | 57 +++++++++++++++++------
 model/nr-gnb-rrc.h                  | 13 +++---
 model/nr-qos-rule-classifier.cc     |  3 ++
 model/nr-qos-rule.h                 | 10 ++++
 model/nr-ue-phy.cc                  |  3 +-
 12 files changed, 219 insertions(+), 56 deletions(-)

diff --git a/helper/nr-epc-helper.h b/helper/nr-epc-helper.h
index 103f72d8..06f7a2b0 100644
--- a/helper/nr-epc-helper.h
+++ b/helper/nr-epc-helper.h
@@ -84,6 +84,14 @@ class NrEpcHelper : public Object
      */
     virtual void AddX2Interface(Ptr<Node> gnbNode1, Ptr<Node> gnbNode2) = 0;
 
+    /**
+     * Add an X2 interface between two gNB devices
+     *
+     * @param gnbDev1 one gNB peer device of the X2 interface
+     * @param gnbDev2 the other gNB peer device of the X2 interface
+     */
+    virtual void AddX2Interface(Ptr<NetDevice> gnbDev1, Ptr<NetDevice> gnbDev2) = 0;
+
     /**
      * Add an S1 interface between an gNB and a SGW
      *
diff --git a/helper/nr-helper.cc b/helper/nr-helper.cc
index 857bd301..1f710be7 100644
--- a/helper/nr-helper.cc
+++ b/helper/nr-helper.cc
@@ -944,7 +944,7 @@ NrHelper::InstallSingleGnbDevice(
 
         // X2 SAPs
         Ptr<NrEpcX2> x2 = n->GetObject<NrEpcX2>();
-        x2->SetEpcX2SapUser(rrc->GetEpcX2SapUser());
+        x2->SetEpcX2SapUser(cellId, rrc->GetEpcX2SapUser());
         rrc->SetEpcX2SapProvider(x2->GetEpcX2SapProvider());
     }
     return dev;
@@ -996,6 +996,31 @@ NrHelper::AddX2Interface(Ptr<Node> gnbNode1, Ptr<Node> gnbNode2)
     m_nrEpcHelper->AddX2Interface(gnbNode1, gnbNode2);
 }
 
+void
+NrHelper::AddX2Interface(NetDeviceContainer gnbDevs)
+{
+    NS_LOG_FUNCTION(this);
+
+    NS_ASSERT_MSG(m_nrEpcHelper, "X2 interfaces cannot be set up when the EPC is not used");
+
+    for (auto i = gnbDevs.Begin(); i != gnbDevs.End(); ++i)
+    {
+        for (auto j = i + 1; j != gnbDevs.End(); ++j)
+        {
+            AddX2Interface(*i, *j);
+        }
+    }
+}
+
+void
+NrHelper::AddX2Interface(Ptr<NetDevice> gnbDev1, Ptr<NetDevice> gnbDev2)
+{
+    NS_LOG_FUNCTION(this);
+    NS_LOG_INFO("setting up the X2 interface");
+
+    m_nrEpcHelper->AddX2Interface(gnbDev1, gnbDev2);
+}
+
 void
 NrHelper::HandoverRequest(Time hoTime,
                           Ptr<NetDevice> ueDev,
@@ -1172,7 +1197,7 @@ NrHelper::AttachToGnb(const Ptr<NetDevice>& ueDevice, const Ptr<NetDevice>& gnbD
         }
     }
 
-    if (m_nrEpcHelper)
+    if (m_nrEpcHelper && ueNetDev->GetTargetGnb() == nullptr)
     {
         // activate default QoS flow
         m_nrEpcHelper->ActivateQosFlow(ueDevice,
