@@ -376,6 +380,16 @@ void
 NrNoBackhaulEpcHelper::AddX2Interface(Ptr<Node> gnb1, Ptr<Node> gnb2)
 {
     NS_LOG_FUNCTION(this << gnb1 << gnb2);
+    AddX2Interface(gnb1->GetDevice(0), gnb2->GetDevice(0));
+}
+
+void
+NrNoBackhaulEpcHelper::AddX2Interface(Ptr<NetDevice> gnbDev1, Ptr<NetDevice> gnbDev2)
+{
+    NS_LOG_FUNCTION(this << gnbDev1 << gnbDev2);
+
+    Ptr<Node> gnb1 = gnbDev1->GetNode();
+    Ptr<Node> gnb2 = gnbDev2->GetNode();
 
     // Create a point to point link between the two eNBs with
     // the corresponding new NetDevices on each side
@@ -383,11 +397,7 @@ NrNoBackhaulEpcHelper::AddX2Interface(Ptr<Node> gnb1, Ptr<Node> gnb2)
