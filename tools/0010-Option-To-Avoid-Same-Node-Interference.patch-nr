From 8190e4b2e7bed4c0378759b0c76e3a14c91e37eb Mon Sep 17 00:00:00 2001
From: Domingo Dirutigliano <me@domy.sh>
Date: Mon, 18 May 2026 11:13:17 +0200
Subject: [PATCH] New paramether to avoid interference on tx from different
 devices on the same node

---
 model/nr-interference.cc | 34 +++++++++++++++++++++++++++-------
 model/nr-interference.h  | 13 +++++++++++--
 model/nr-spectrum-phy.cc | 21 +++++++++++++++++++++
 model/nr-spectrum-phy.h  |  2 ++
 4 files changed, 61 insertions(+), 9 deletions(-)

diff --git a/model/nr-interference.cc b/model/nr-interference.cc
index 15af62a6..d36f3cc1 100644
--- a/model/nr-interference.cc
+++ b/model/nr-interference.cc
@@ -8,7 +8,10 @@
 #include "nr-spectrum-signal-parameters.h"
 
 #include "ns3/log.h"
+#include "ns3/net-device.h"
+#include "ns3/node.h"
 #include "ns3/simulator.h"
+#include "ns3/spectrum-phy.h"
 
 #include <algorithm>
 
@@ -153,12 +156,12 @@ NrInterference::ConditionallyEvaluateChunk()
 
         for (auto& cp : m_mimoChunkProcessors)
         {
-            // Covariance matrix of noise plus out-of-cell interference
-            auto outOfCellInterfCov = CalcOutOfCellInterfCov();
-
             // Compute the MIMO SINR separately for each received signal.
             for (auto& rxSignal : m_rxSignalsMimo)
             {
+                // Covariance matrix of noise plus out-of-cell interference
+                auto outOfCellInterfCov = CalcOutOfCellInterfCov(rxSignal);
+
                 // Use the UE's RNTI to distinguish multiple received signals
                 auto nrRxSignal = DynamicCast<const NrSpectrumSignalParametersDataFrame>(rxSignal);
                 uint16_t rnti = nrRxSignal ? nrRxSignal->rnti : 0;
@@ -400,8 +403,14 @@ NrInterference::IsChunkProcessorSet()
     return (!m_mimoChunkProcessors.empty());
 }
 
+void
+NrInterference::SetSameNodeInterference(bool sameNodeInterference)
+{
+    m_sameNodeInterference = sameNodeInterference;
+}
+
 NrCovMat
-NrInterference::CalcOutOfCellInterfCov() const
+NrInterference::CalcOutOfCellInterfCov(Ptr<const SpectrumSignalParameters> rxSignal) const
 {
     // Extract dimensions from first receive signal. Interference signals have equal dimensions
     NS_ASSERT_MSG(!(m_rxSignalsMimo.empty()), "At least one receive signal is required");
@@ -430,7 +439,7 @@ NrInterference::CalcOutOfCellInterfCov() const
             continue;
         }
 
-        AddInterference(allSignalsNoiseCov, intfSignal);
+        AddInterference(allSignalsNoiseCov, intfSignal, rxSignal);
     }
     return allSignalsNoiseCov;
 }
@@ -452,14 +461,25 @@ NrInterference::CalcCurrInterfCov(Ptr<const SpectrumSignalParameters> rxSignal,
                        m_allSignalsMimo.end()),
                       "RX signal already deleted from m_allSignalsMimo");
 
-        AddInterference(interfNoiseCov, otherSignal);
+        AddInterference(interfNoiseCov, otherSignal, rxSignal);
     }
     return interfNoiseCov;
 }
 
 void
-NrInterference::AddInterference(NrCovMat& covMat, Ptr<const SpectrumSignalParameters> signal) const
+NrInterference::AddInterference(NrCovMat& covMat,
+                                Ptr<const SpectrumSignalParameters> signal,
+                                Ptr<const SpectrumSignalParameters> rxSignal) const
 {
+    if (!m_sameNodeInterference && signal->txPhy && rxSignal->txPhy)
+    {
+        if (signal->txPhy->GetDevice()->GetNode() == rxSignal->txPhy->GetDevice()->GetNode())
+        {
+            NS_LOG_DEBUG("Ignoring interference between signals from the same node.");
+            return;
+        }
+    }
+
     const auto& chanSpct = *(signal->spectrumChannelMatrix);
     if (signal->precodingMatrix)
     {
diff --git a/model/nr-interference.h b/model/nr-interference.h
index 82e3fc8e..3256885b 100644
--- a/model/nr-interference.h
+++ b/model/nr-interference.h
@@ -126,12 +126,18 @@ class NrInterference : public NrInterferenceBase
      */
     bool IsChunkProcessorSet();
 
+    /**
+     * @brief Set same node interference flag
+     */
+    void SetSameNodeInterference(bool sameNodeInterference);
+
   private:
     /// @brief Calculate interference-plus-noise covariance matrix for signals not in m_rxSignals
     /// This function computes the interference signals from all out-of-cell interferers. The
     /// intra-cell interference signals that are part of m_rxSignals are skipped.
+    /// @param rxSignal the receive signal of interest
     /// @return the interference+noise covariance matrix for out-of-cell interference
-    NrCovMat CalcOutOfCellInterfCov() const;
+    NrCovMat CalcOutOfCellInterfCov(Ptr<const SpectrumSignalParameters> rxSignal) const;
 
     /// @brief Add the remaining interference to the interference-and-noise covariance matrix
     /// This function is required for MU-MIMO UL, where the signal from a different UE within the
@@ -145,7 +151,8 @@ class NrInterference : public NrInterferenceBase
     /// @brief Add the covariance of the signal to an existing covariance matrix
     /// @param covMat the existing interference-and-noise covariance matrix
     /// @param signal the signal to be added
-    void AddInterference(NrCovMat& covMat, Ptr<const SpectrumSignalParameters> signal) const;
+    /// @param rxSignal the signal of interest
+    void AddInterference(NrCovMat& covMat, Ptr<const SpectrumSignalParameters> signal, Ptr<const SpectrumSignalParameters> rxSignal) const;
 
     /// @brief Compute the SINR of the current receive signal
     /// @param outOfCellInterfCov the covariance matrix of out-of-cell signals, plus noise
@@ -163,6 +170,8 @@ class NrInterference : public NrInterferenceBase
     /// The processor instances that are notified whenever a new interference chunk is calculated
     std::list<Ptr<NrMimoChunkProcessor>> m_mimoChunkProcessors;
 
+    bool m_sameNodeInterference = false;
+
     /**
      * Noise and Interference (thus Ni) event.
      */
diff --git a/model/nr-spectrum-phy.cc b/model/nr-spectrum-phy.cc
index 45d8e5cc..adbdda4e 100644
--- a/model/nr-spectrum-phy.cc
+++ b/model/nr-spectrum-phy.cc
@@ -165,6 +165,12 @@ NrSpectrumPhy::GetTypeId()
                 UintegerValue(1),
                 MakeUintegerAccessor(&NrSpectrumPhy::SetNumPanels, &NrSpectrumPhy::GetNumPanels),
                 MakeUintegerChecker<uint8_t>())
+            .AddAttribute(
+                "SameNodeInterference",
+                "If false, transmissions from devices on the same node do not create interference.",
+                BooleanValue(true),
+                MakeBooleanAccessor(&NrSpectrumPhy::m_sameNodeInterference),
+                MakeBooleanChecker())
             .AddTraceSource("RxPacketTraceGnb",
                             "The no. of packets received and transmitted by the Base Station",
                             MakeTraceSourceAccessor(&NrSpectrumPhy::m_rxPacketTraceGnb),
@@ -656,6 +662,21 @@ NrSpectrumPhy::StartRx(Ptr<SpectrumSignalParameters> params)
         params->spectrumChannelMatrix = CreateSpectrumChannelMatrix(params);
     }
 
+    m_interferenceData->SetSameNodeInterference(m_sameNodeInterference);
+    m_interferenceCtrl->SetSameNodeInterference(m_sameNodeInterference);
+    if (m_interferenceSrs)
+    {
+        m_interferenceSrs->SetSameNodeInterference(m_sameNodeInterference);
+    }
+    if (m_interferenceCsiRs)
+    {
+        m_interferenceCsiRs->SetSameNodeInterference(m_sameNodeInterference);
+    }
+    if (m_interferenceCsiIm)
+    {
+        m_interferenceCsiIm->SetSameNodeInterference(m_sameNodeInterference);
+    }
+
     // pass it to interference calculations regardless of the type (nr or non-nr)
     m_interferenceData->AddSignalMimo(params, duration);
 
diff --git a/model/nr-spectrum-phy.h b/model/nr-spectrum-phy.h
index 2bec7330..f25eeb5e 100644
--- a/model/nr-spectrum-phy.h
+++ b/model/nr-spectrum-phy.h
@@ -794,6 +794,8 @@ class NrSpectrumPhy : public SpectrumPhy
         false}; //!< Whether this spectrum phy is configure to work in an unlicensed mode.
                 //   Unlicensed mode additionally to licensed mode allows channel monitoring to
                 //   discover if is busy before transmission.
+    bool m_sameNodeInterference{true}; //!< If false, transmissions from devices on the same node do
+                                       //!< not create interference.
 
     Ptr<SpectrumChannel> m_channel{
         nullptr}; //!< channel is needed to be able to connect listener spectrum phy (AddRx) or to
-- 
2.50.1 (Apple Git-155)

