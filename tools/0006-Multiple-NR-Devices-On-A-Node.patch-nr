From 24b300206f28ba1118bf7072b8c61739c71e8c33 Mon Sep 17 00:00:00 2001
From: Domingo Dirutigliano <me@domy.sh>
Date: Mon, 27 Apr 2026 00:13:41 +0200
Subject: [PATCH] allowing more than one nr device on the same node

---
 helper/nr-helper.cc                 | 11 ++++++++++-
 helper/nr-no-backhaul-epc-helper.cc | 27 ++++++++++++++++++---------
 model/nr-epc-gnb-application.cc     |  7 +++++++
 model/nr-epc-gnb-application.h      |  6 ++++++
 4 files changed, 41 insertions(+), 10 deletions(-)

diff --git a/helper/nr-helper.cc b/helper/nr-helper.cc
index cf1a8dd8..0daf5d53 100644
--- a/helper/nr-helper.cc
+++ b/helper/nr-helper.cc
@@ -922,7 +922,16 @@ NrHelper::InstallSingleGnbDevice(
     {
         NS_LOG_INFO("adding this gNB to the EPC");
         m_nrEpcHelper->AddGnb(n, dev, cellId);
-        Ptr<NrEpcGnbApplication> gnbApp = n->GetApplication(0)->GetObject<NrEpcGnbApplication>();
+        Ptr<NrEpcGnbApplication> gnbApp = nullptr;
+        for (uint32_t i = 0; i < n->GetNApplications(); ++i)
+        {
+            Ptr<NrEpcGnbApplication> app = n->GetApplication(i)->GetObject<NrEpcGnbApplication>();
+            if (app && app->GetCellId() == cellId)
+            {
+                gnbApp = app;
+                break;
+            }
+        }
         NS_ASSERT_MSG(gnbApp != nullptr, "cannot retrieve NrEpcGnbApplication");
 
         // S1 SAPs
diff --git a/helper/nr-no-backhaul-epc-helper.cc b/helper/nr-no-backhaul-epc-helper.cc
index 485ee789..f2fe49b7 100644
--- a/helper/nr-no-backhaul-epc-helper.cc
+++ b/helper/nr-no-backhaul-epc-helper.cc
@@ -353,14 +353,14 @@ NrNoBackhaulEpcHelper::AddGnb(Ptr<Node> gnb, Ptr<NetDevice> nrGnbNetDevice, uint
     Ptr<NrEpcGnbApplication> gnbApp =
         CreateObject<NrEpcGnbApplication>(nrGnbSocket, nrGnbSocket6, cellId);
     gnb->AddApplication(gnbApp);
-    NS_ASSERT(gnb->GetNApplications() == 1);
-    NS_ASSERT_MSG(gnb->GetApplication(0)->GetObject<NrEpcGnbApplication>(),
-                  "cannot retrieve NrEpcGnbApplication");
-    NS_LOG_LOGIC("gnb: " << gnb << ", gnb->GetApplication (0): " << gnb->GetApplication(0));
-
-    NS_LOG_INFO("Create NrEpcX2 entity");
-    Ptr<NrEpcX2> x2 = CreateObject<NrEpcX2>();
-    gnb->AggregateObject(x2);
+    NS_LOG_LOGIC("gnb: " << gnb << ", added gnbApp for cellId " << cellId);
+
+    if (gnb->GetObject<NrEpcX2>() == nullptr)
+    {
+        NS_LOG_INFO("Create NrEpcX2 entity");
+        Ptr<NrEpcX2> x2 = CreateObject<NrEpcX2>();
+        gnb->AggregateObject(x2);
+    }
 }
 
 void
@@ -595,7 +595,16 @@ NrNoBackhaulEpcHelper::AddS1Interface(Ptr<Node> gnb,
     int retval = gnbS1uSocket->Bind(InetSocketAddress(gnbAddress, m_gtpuUdpPort));
     NS_ASSERT(retval == 0);
 
-    Ptr<NrEpcGnbApplication> gnbApp = gnb->GetApplication(0)->GetObject<NrEpcGnbApplication>();
+    Ptr<NrEpcGnbApplication> gnbApp = nullptr;
+    for (uint32_t i = 0; i < gnb->GetNApplications(); ++i)
+    {
+        Ptr<NrEpcGnbApplication> app = gnb->GetApplication(i)->GetObject<NrEpcGnbApplication>();
+        if (app && app->GetCellId() == cellId)
+        {
+            gnbApp = app;
+            break;
+        }
+    }
     NS_ASSERT_MSG(gnbApp, "NrEpcGnbApplication not available");
     gnbApp->AddS1Interface(gnbS1uSocket, gnbAddress, sgwAddress);
 
diff --git a/model/nr-epc-gnb-application.cc b/model/nr-epc-gnb-application.cc
index df4f7356..351deb85 100644
--- a/model/nr-epc-gnb-application.cc
+++ b/model/nr-epc-gnb-application.cc
@@ -132,6 +132,13 @@ NrEpcGnbApplication::GetS1apSapGnb()
     return m_s1apSapGnb;
 }
 
+uint16_t
+NrEpcGnbApplication::GetCellId() const
+{
+    return m_cellId;
+}
+
+
 void
 NrEpcGnbApplication::DoInitialUeMessage(uint64_t imsi, uint16_t rnti)
 {
diff --git a/model/nr-epc-gnb-application.h b/model/nr-epc-gnb-application.h
index 376c4e52..742f7942 100644
--- a/model/nr-epc-gnb-application.h
+++ b/model/nr-epc-gnb-application.h
@@ -108,6 +108,12 @@ class NrEpcGnbApplication : public Application
      */
     NrEpcS1apSapGnb* GetS1apSapGnb();
 
+    /**
+     * @return the cell ID
+     */
+    uint16_t GetCellId() const;
+
+
     /**
      * Method to be assigned to the recv callback of the NR socket. It is called when the gNB
      * receives a data packet from the radio interface that is to be forwarded to the SGW.
-- 
2.50.1 (Apple Git-155)

