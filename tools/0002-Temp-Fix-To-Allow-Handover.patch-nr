From 3366927eb74106fc47637c5dfcec88c3077fed65 Mon Sep 17 00:00:00 2001
From: Domingo Dirutigliano <me@domy.sh>
Date: Thu, 26 Feb 2026 19:41:35 +0100
Subject: [PATCH] Force handover procedure between differente gNB nodes

---
 helper/beamforming-helper-base.h       |  8 ++++
 helper/ideal-beamforming-helper.cc     | 20 ++++++++
 helper/ideal-beamforming-helper.h      |  3 ++
 helper/nr-helper.cc                    | 65 ++++++++++++++++++++++++++
 helper/nr-helper.h                     | 19 ++++++++
 helper/realistic-beamforming-helper.cc | 47 +++++++++++++++++++
 helper/realistic-beamforming-helper.h  |  3 ++
 model/nr-epc-ue-nas.cc                 |  7 ++-
 model/nr-mac-scheduler-ns3.cc          | 11 ++++-
 model/nr-rrc-protocol-ideal.cc         | 15 ++++--
 model/nr-ue-rrc.cc                     |  2 +-
 11 files changed, 189 insertions(+), 11 deletions(-)

diff --git a/helper/beamforming-helper-base.h b/helper/beamforming-helper-base.h
index baa4a71e..44caf364 100644
--- a/helper/beamforming-helper-base.h
+++ b/helper/beamforming-helper-base.h
@@ -54,6 +54,14 @@ class BeamformingHelperBase : public Object
     virtual void AddBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
                                     const Ptr<NrUeNetDevice>& ueDev) = 0;
 
+    /**
+     * @brief Removes the beamforming task for a handoff
+     * @param gNbDev gNb device
+     * @param ueDev UE device
+     */
+    virtual void RemoveBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
+                                       const Ptr<NrUeNetDevice>& ueDev) = 0;
+
     /**
      * @brief Set the beamforming method that will be executed each
      * time when is necessary to update the beamforming algorithms
diff --git a/helper/ideal-beamforming-helper.cc b/helper/ideal-beamforming-helper.cc
index 256a82ab..9594e46f 100644
--- a/helper/ideal-beamforming-helper.cc
+++ b/helper/ideal-beamforming-helper.cc
@@ -84,6 +84,26 @@ IdealBeamformingHelper::AddBeamformingTask(const Ptr<NrGnbNetDevice>& gnbDev,
     }
 }
 
+void
+IdealBeamformingHelper::RemoveBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
+                                              const Ptr<NrUeNetDevice>& ueDev)
+{
+    NS_LOG_FUNCTION(this);
+    for (std::size_t ccId = 0; ccId < gNbDev->GetCcMapSize(); ccId++)
+    {
+        Ptr<NrSpectrumPhy> gnbSpectrumPhy = gNbDev->GetPhy(ccId)->GetSpectrumPhy();
+        Ptr<NrSpectrumPhy> ueSpectrumPhy = ueDev->GetPhy(ccId)->GetSpectrumPhy();
+
+        auto it = std::find(m_spectrumPhyPair.begin(),
+                            m_spectrumPhyPair.end(),
+                            std::make_pair(gnbSpectrumPhy, ueSpectrumPhy));
+        if (it != m_spectrumPhyPair.end())
+        {
+            m_spectrumPhyPair.erase(it);
+        }
+    }
+}
+
 void
 IdealBeamformingHelper::Run() const
 {
diff --git a/helper/ideal-beamforming-helper.h b/helper/ideal-beamforming-helper.h
index 954d2757..3e6eb06c 100644
--- a/helper/ideal-beamforming-helper.h
+++ b/helper/ideal-beamforming-helper.h
@@ -71,6 +71,9 @@ class IdealBeamformingHelper : public BeamformingHelperBase
     void AddBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
                             const Ptr<NrUeNetDevice>& ueDev) override;
 
+    void RemoveBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
+                               const Ptr<NrUeNetDevice>& ueDev) override;
+
   protected:
     // inherited from Object
     void DoInitialize() override;
diff --git a/helper/nr-helper.cc b/helper/nr-helper.cc
index 4ca8bcb6..cf1a8dd8 100644
--- a/helper/nr-helper.cc
+++ b/helper/nr-helper.cc
@@ -21,6 +21,8 @@
 #include "ns3/deprecated.h"
 #include "ns3/multi-model-spectrum-channel.h"
 #include "ns3/names.h"
+#include "ns3/net-device-container.h"
+#include "ns3/node-container.h"
 #include "ns3/node-list.h"
 #include "ns3/nr-ch-access-manager.h"
 #include "ns3/nr-chunk-processor.h"
@@ -595,6 +597,10 @@ NrHelper::InstallSingleUeDevice(
     dev->SetAttribute("NrUeComponentCarrierManager", PointerValue(ccmUe));
     dev->SetAttribute("Imsi", UintegerValue(n->GetId()));
 
+    rrc->TraceConnectWithoutContext(
+        "HandoverStart",
+        MakeBoundCallback(&NrHelper::OnHandoverStartTrampoline, this, dev));
+
     n->AddDevice(dev);
 
     if (m_nrEpcHelper != nullptr)
@@ -1174,6 +1180,65 @@ NrHelper::AttachToGnb(const Ptr<NetDevice>& ueDevice, const Ptr<NetDevice>& gnbD
     }
 }
 
+void
+NrHelper::OnHandoverStartTrampoline(NrHelper* helper,
+                                    Ptr<NetDevice> ueDevice,
+                                    const uint64_t imsi,
+                                    uint16_t cellId,
+                                    uint16_t rnti,
+                                    uint16_t targetCellId)
+{
+    helper->OnHandoverStart(ueDevice, imsi, cellId, rnti, targetCellId);
+}
+
+void
+NrHelper::OnHandoverStart(Ptr<NetDevice> ueDevice,
+                          const uint64_t imsi,
+                          uint16_t cellId,
+                          uint16_t rnti,
+                          uint16_t targetCellId)
+{
+    NS_LOG_FUNCTION(this << ueDevice << imsi << cellId << rnti << targetCellId);
+
+    if (m_beamformingHelper)
+    {
+        Ptr<NrGnbNetDevice> sourceGnb;
+        Ptr<NrGnbNetDevice> targetGnb;
+
+        for (auto it = NodeList::Begin(); it != NodeList::End(); ++it)
+        {
+            Ptr<Node> node = *it;
+            for (uint32_t i = 0; i < node->GetNDevices(); ++i)
+            {
+                Ptr<NrGnbNetDevice> gnb = DynamicCast<NrGnbNetDevice>(node->GetDevice(i));
+                if (gnb)
+                {
+                    if (gnb->GetCellId() == cellId)
+                    {
+                        sourceGnb = gnb;
+                    }
+                    if (gnb->GetCellId() == targetCellId)
+                    {
+                        targetGnb = gnb;
+                    }
+                }
+            }
+            if (sourceGnb && targetGnb)
+            {
+                break;
+            }
+        }
+
+        if (targetGnb != sourceGnb)
+        {
+            m_beamformingHelper->RemoveBeamformingTask(sourceGnb,
+                                                       DynamicCast<NrUeNetDevice>(ueDevice));
+
+            AttachToGnb(ueDevice, targetGnb);
+        }
+    }
+}
+
 uint8_t
 NrHelper::ActivateDedicatedQosFlow(NetDeviceContainer ueDevices,
                                    NrQosFlow flow,
diff --git a/helper/nr-helper.h b/helper/nr-helper.h
index 178874c6..e1086c1b 100644
--- a/helper/nr-helper.h
+++ b/helper/nr-helper.h
@@ -316,6 +316,25 @@ class NrHelper : public Object
      */
     void AttachToGnb(const Ptr<NetDevice>& ueDevice, const Ptr<NetDevice>& gnbDevice);
 
+    /**
+     * @brief Trampoline to connect HandoverStart trace
+     */
+    static void OnHandoverStartTrampoline(NrHelper* helper,
+                                          Ptr<NetDevice> ueDevice,
+                                          const uint64_t imsi,
+                                          uint16_t cellId,
+                                          uint16_t rnti,
+                                          uint16_t targetCellId);
+
+    /**
+     * @brief Handle HandoverStart trace to update beamforming tasks
+     */
+    void OnHandoverStart(Ptr<NetDevice> ueDevice,
+                         const uint64_t imsi,
+                         uint16_t cellId,
+                         uint16_t rnti,
+                         uint16_t targetCellId);
+
     /**
      * @brief Enables the following traces:
      * Transmitted/Received Control Messages
diff --git a/helper/realistic-beamforming-helper.cc b/helper/realistic-beamforming-helper.cc
index 290d4ff2..8581fd31 100644
--- a/helper/realistic-beamforming-helper.cc
+++ b/helper/realistic-beamforming-helper.cc
@@ -74,6 +74,53 @@ RealisticBeamformingHelper::AddBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev
     }
 }
 
+void
+RealisticBeamformingHelper::RemoveBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
+                                                  const Ptr<NrUeNetDevice>& ueDev)
+{
+    NS_LOG_FUNCTION(this);
+
+    for (auto it = m_spectrumPhyPairToAlgorithm.begin(); it != m_spectrumPhyPairToAlgorithm.end();)
+    {
+        bool remove = false;
+        if (gNbDev)
+        {
+            for (std::size_t ccId = 0; ccId < gNbDev->GetCcMapSize(); ccId++)
+            {
+                Ptr<NrSpectrumPhy> gnbSpectrumPhy = gNbDev->GetPhy(ccId)->GetSpectrumPhy();
+                Ptr<NrSpectrumPhy> ueSpectrumPhy = ueDev->GetPhy(ccId)->GetSpectrumPhy();
+                if (it->first.first == gnbSpectrumPhy && it->first.second == ueSpectrumPhy)
+                {
+                    remove = true;
+                    break;
+                }
+            }
+        }
+        else
+        {
+            for (std::size_t ccId = 0; ccId < ueDev->GetCcMapSize(); ccId++)
+            {
+                Ptr<NrSpectrumPhy> ueSpectrumPhy = ueDev->GetPhy(ccId)->GetSpectrumPhy();
+                if (it->first.second == ueSpectrumPhy)
+                {
+                    remove = true;
+                    break;
+                }
+            }
+        }
+
+        if (remove)
+        {
+            it->second->Dispose();
+            it = m_spectrumPhyPairToAlgorithm.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+}
+
 BeamformingVectorPair
 RealisticBeamformingHelper::GetBeamformingVectors(const Ptr<NrSpectrumPhy>& gnbSpectrumPhy,
                                                   const Ptr<NrSpectrumPhy>& ueSpectrumPhy) const
diff --git a/helper/realistic-beamforming-helper.h b/helper/realistic-beamforming-helper.h
index 836ccf23..83534652 100644
--- a/helper/realistic-beamforming-helper.h
+++ b/helper/realistic-beamforming-helper.h
@@ -71,6 +71,9 @@ class RealisticBeamformingHelper : public BeamformingHelperBase
     void AddBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
                             const Ptr<NrUeNetDevice>& ueDev) override;
 
+    void RemoveBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
+                               const Ptr<NrUeNetDevice>& ueDev) override;
+
     /**
      * @brief Function that forwards the SRS SINR to the correct RealisticBeamformingAlgorithm
      * @param srsSinr
diff --git a/model/nr-epc-ue-nas.cc b/model/nr-epc-ue-nas.cc
index f00519f5..069ec19f 100644
--- a/model/nr-epc-ue-nas.cc
+++ b/model/nr-epc-ue-nas.cc
@@ -170,10 +170,9 @@ NrEpcUeNas::ActivateQosFlow(NrQosFlow flow, Ptr<NrQosRule> rule)
     switch (m_state)
     {
     case ACTIVE:
-        NS_FATAL_ERROR(
-            "the necessary NAS signaling to activate a QoS flow after the initial context "
-            "has already been setup is not implemented");
-        break;
+        NS_LOG_WARN("the necessary NAS signaling to activate a QoS flow after the initial context "
+                    "has already been setup is not implemented");
+        // break; execute bearers activation
 
     default:
         QosFlowToBeActivated qftba;
diff --git a/model/nr-mac-scheduler-ns3.cc b/model/nr-mac-scheduler-ns3.cc
index 74c289f9..551e5f6a 100644
--- a/model/nr-mac-scheduler-ns3.cc
+++ b/model/nr-mac-scheduler-ns3.cc
@@ -918,7 +918,16 @@ NrMacSchedulerNs3::DoSchedDlCqiInfoReq(
 
     for (const auto& cqi : params.m_cqiList)
     {
-        NS_ASSERT(m_ueMap.find(cqi.m_rnti) != m_ueMap.end());
+        if (m_ueMap.find(cqi.m_rnti) == m_ueMap.end())
+        {
+            NS_LOG_WARN("Transfer in a forced way the context for RNTI " << cqi.m_rnti);
+            NrMacCschedSapProvider::CschedUeConfigReqParameters req;
+            req.m_rnti = cqi.m_rnti;
+            req.m_beamId = ns3::BeamId(0, 0);
+            req.m_transmissionMode = 0;
+            req.m_reconfigureFlag = false;
+            DoCschedUeConfigReq(req);
+        }
         const std::shared_ptr<NrMacSchedulerUeInfo>& ue = m_ueMap.find(cqi.m_rnti)->second;
         m_cqiManagement.DlCqiReported(cqi, ue, expirationTime, m_maxDlMcs, GetBandwidthInRbg());
         m_csiFeedbackReceived(GetCellId(), GetBwpId(), ue);
diff --git a/model/nr-rrc-protocol-ideal.cc b/model/nr-rrc-protocol-ideal.cc
index b999ef01..fa49e451 100644
--- a/model/nr-rrc-protocol-ideal.cc
+++ b/model/nr-rrc-protocol-ideal.cc
@@ -154,7 +154,15 @@ NrUeRrcProtocolIdeal::DoSendMeasurementReport(NrRrcSap::MeasurementReport msg)
 void
 NrUeRrcProtocolIdeal::DoSendIdealUeContextRemoveRequest(uint16_t rnti)
 {
-    NS_FATAL_ERROR("NrUeRrcProtocolIdeal does not have RLF functionality yet");
+    NS_LOG_UNCOND("NrUeRrcProtocolIdeal::DoSendIdealUeContextRemoveRequest for RNTI "
+                  << rnti << " CellId " << m_rrc->GetCellId());
+    m_rnti = rnti;
+    SetGnbRrcSapProvider();
+
+    Simulator::Schedule(RRC_IDEAL_MSG_DELAY,
+                        &NrGnbRrcSapProvider::RecvIdealUeContextRemoveRequest,
+                        m_gnbRrcSapProvider,
+                        m_rnti);
 }
 
 void
@@ -241,10 +249,7 @@ NrGnbRrcProtocolIdeal::GetUeRrcSapProvider(uint16_t rnti)
 void
 NrGnbRrcProtocolIdeal::SetUeRrcSapProvider(uint16_t rnti, NrUeRrcSapProvider* p)
 {
-    std::map<uint16_t, NrUeRrcSapProvider*>::iterator it;
-    it = m_gnbRrcSapProviderMap.find(rnti);
-    NS_ASSERT_MSG(it != m_gnbRrcSapProviderMap.end(), "could not find RNTI = " << rnti);
-    it->second = p;
+    m_gnbRrcSapProviderMap[rnti] = p;
 }
 
 void
diff --git a/model/nr-ue-rrc.cc b/model/nr-ue-rrc.cc
index 9dde63e2..4bd6e5bb 100644
--- a/model/nr-ue-rrc.cc
+++ b/model/nr-ue-rrc.cc
@@ -806,13 +806,13 @@ NrUeRrc::DoForceCampedOnGnb(uint16_t cellId, uint32_t arfcn)
     switch (m_state)
     {
     case IDLE_START:
+    case IDLE_CELL_SEARCH:
         m_cellId = cellId;
         m_initDlArfcn = arfcn;
         m_cphySapProvider.at(GetPrimaryDlIndex())->SynchronizeWithGnb(m_cellId, m_initDlArfcn);
         SwitchToState(IDLE_WAIT_MIB);
         break;
 
-    case IDLE_CELL_SEARCH:
     case IDLE_WAIT_MIB_SIB1:
     case IDLE_WAIT_SIB1:
         NS_FATAL_ERROR("cannot abort cell selection " << ToString(m_state));
