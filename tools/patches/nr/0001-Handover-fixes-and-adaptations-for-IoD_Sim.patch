+void
+RealisticBeamformingHelper::RemoveBeamformingTask(const Ptr<NrGnbNetDevice>& gNbDev,
+                                                  const Ptr<NrUeNetDevice>& ueDev)
+{
+    NS_LOG_FUNCTION(this);
+
+    for (auto it = m_spectrumPhyPairToAlgorithm.begin(); it != m_spectrumPhyPairToAlgorithm.end();)
+    {
+        bool remove = false;
+        if (gNbDev)
+        {
+            for (std::size_t ccId = 0; ccId < gNbDev->GetCcMapSize(); ccId++)
+            {
+                Ptr<NrSpectrumPhy> gnbSpectrumPhy = gNbDev->GetPhy(ccId)->GetSpectrumPhy();
+                Ptr<NrSpectrumPhy> ueSpectrumPhy = ueDev->GetPhy(ccId)->GetSpectrumPhy();
+                if (it->first.first == gnbSpectrumPhy && it->first.second == ueSpectrumPhy)
+                {
+                    remove = true;
+                    break;
+                }
+            }
+        }
+        else
+        {
+            for (std::size_t ccId = 0; ccId < ueDev->GetCcMapSize(); ccId++)
+            {
+                Ptr<NrSpectrumPhy> ueSpectrumPhy = ueDev->GetPhy(ccId)->GetSpectrumPhy();
+                if (it->first.second == ueSpectrumPhy)
+                {
+                    remove = true;
+                    break;
+                }
+            }
+        }
+
+        if (remove)
+        {
+            it->second->Dispose();
+            it = m_spectrumPhyPairToAlgorithm.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+}
