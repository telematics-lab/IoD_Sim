+void
+NrHelper::OnHandoverStartTrampoline(NrHelper* helper,
+                                    Ptr<NetDevice> ueDevice,
+                                    const uint64_t imsi,
+                                    uint16_t cellId,
+                                    uint16_t rnti,
+                                    uint16_t targetCellId)
+{
+    helper->OnHandoverStart(ueDevice, imsi, cellId, rnti, targetCellId);
+}
+
+void
+NrHelper::OnHandoverStart(Ptr<NetDevice> ueDevice,
+                          const uint64_t imsi,
+                          uint16_t cellId,
+                          uint16_t rnti,
+                          uint16_t targetCellId)
+{
+    NS_LOG_FUNCTION(this << ueDevice << imsi << cellId << rnti << targetCellId);
+
+    if (m_beamformingHelper)
+    {
+        Ptr<NrGnbNetDevice> sourceGnb;
+        Ptr<NrGnbNetDevice> targetGnb;
+
+        for (auto it = NodeList::Begin(); it != NodeList::End(); ++it)
+        {
+            Ptr<Node> node = *it;
+            for (uint32_t i = 0; i < node->GetNDevices(); ++i)
+            {
+                Ptr<NrGnbNetDevice> gnb = DynamicCast<NrGnbNetDevice>(node->GetDevice(i));
+                if (gnb)
+                {
+                    if (gnb->GetCellId() == cellId)
+                    {
+                        sourceGnb = gnb;
+                    }
+                    if (gnb->GetCellId() == targetCellId)
+                    {
+                        targetGnb = gnb;
+                    }
+                }
+            }
+            if (sourceGnb && targetGnb)
+            {
+                break;
+            }
+        }
+
+        if (targetGnb != sourceGnb)
+        {
+            m_beamformingHelper->RemoveBeamformingTask(sourceGnb,
+                                                       DynamicCast<NrUeNetDevice>(ueDevice));
+
+            AttachToGnb(ueDevice, targetGnb);
+        }
+    }
+}
+
 uint8_t
 NrHelper::ActivateDedicatedQosFlow(NetDeviceContainer ueDevices,
                                    NrQosFlow flow,
