+void
+NrGnbMac::ForwardUpToRlc(NrMacSapUser* msu, NrMacSapUser::ReceivePduParameters params)
+{
+    // Need to verify if the UE / LC is still attached
+    auto rntiIt = m_rlcAttached.find(params.rnti);
+    if (rntiIt != m_rlcAttached.end())
+    {
+        auto lcidIt = rntiIt->second.find(params.lcid);
+        if (lcidIt != rntiIt->second.end())
+        {
+            if (lcidIt->second == msu) // pointer match
+            {
+                msu->ReceivePdu(params);
+            }
+        }
+    }
+}
+
+void
+NrGnbMac::DelayedDlRlcBufferReq(NrMacSchedSapProvider::SchedDlRlcBufferReqParameters params)
+{
+    // Need to verify if the UE is still attached before reporting to scheduler
+    auto rntiIt = m_rlcAttached.find(params.m_rnti);
+    if (rntiIt != m_rlcAttached.end())
+    {
+        m_macSchedSapProvider->SchedDlRlcBufferReq(params);
     }
 }
 
