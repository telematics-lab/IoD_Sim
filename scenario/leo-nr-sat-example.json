{
  // Nome dello scenario, verrà contenuto nel nome della cartella dei risultati (in caso si usi "resultsPath")
  "name": "leo-nr-sat-example",
  // resultsPath è la cartella in cui verranno create diverse cartelle, una per esecuzione della simulazione con all'interno i file con i risultati della simulazione
  "resultsPath": "../results/",
  // *
  // "resultPath" è un parametro simile al precedente, è mutuamente esclusivo col precedente parametro, e specifica la cartella
  // dove verrà memorizzato il risultato della simulazione, senza creare sotto cartelle, questo può risultare utile per sistemi in cui
  // questo json di scenario è generato mediante script/interfaccia, e che quindi in modo automatico poi si vogliano leggere i risultati
  // dell'esecuzione, associando a questo parametro una cartella temporanea ad esempio.
  // *
  // Se impostato a true logOnFile attiverà nelle varie parti della simulazione tutte le funzionalità utili a salvare i risultati su file
  "logOnFile": true,
  // Durata totale della simulazione (tempo all'interno della simulazione)
  "duration": 5,
  // Parametro utile a selezionare un intervallo di tempo per il quale periodicamente
  // Si andranno a estrarre e salvare su app-statistics-periodic.txt le statistiche su tutti i flussi
  // Aperti nella simulazione
  "appStatisticsReportInterval": 0.1,
  // 1. STATIC NS3 CONFIGURATION
  // Questa sezione sovrascrive i parametri globali di default di ns-3.
  "staticNs3Config": [
    {
      "name": "ns3::GeocentricMobilityModel::EarthSpheroidType",
      "value": "SPHERE" // Modello della terra semplificato a sfera, consigliato per LEO
    },
    {
      "name": "ns3::GeoLeoOrbitMobility::Precision",
      "value": "500ms" // Precisione del tracciamento delle orbite (aggiornate ogni 500ms)
    },
    {
      "name": "ns3::GeoConstantVelocityMobility::Precision",
      "value": "500ms" // Precisione del tracciamento dei veicoli a velocità costante (aggiornate ogni 500ms)
    },
    {
      "name": "ns3::TraceBasedMobilityModel::Precision",
      "value": "500ms" // Precisione del tracciamento dei veicoli basato su trace (aggiornate ogni 500ms)
    },
    {
      "name": "ns3::NrRlcUm::MaxTxBufferSize",
      "value": 999999999 // Buffer infinito all'RLC come indicato negli esempi di lena
    },
    {
      "name": "ns3::NrMacSchedulerNs3::EnableHarqReTx",
      "value": false // Disabilitazione standard per comunicazioni satellitari dove il delay e' troppo elevato per l'HARQ
    },
    {
      // Parametro essenziale in scenari multibeam al fine di evitare interferenza tra le varie
      // gNB presenti sullo stesso nodo che ricreano l'ambiente multibeam
      "name": "ns3::NrSpectrumPhy::SameNodeInterference",
      "value": false
    }
  ],
  // 2. DIMENSIONI DEL MONDO
  // Definisce uno spazio sufficientemente grande per simulare la superficie terrestre e l'orbita dei satelliti
  "world": {
    "size": {
      "X": "40000000",
      "Y": "40000000",
      "Z": "40000000"
    },
    "buildings": []
  },
  // 3. LIVELLO FISICO (PHY LAYER) E CONFIGURAZIONE FDM/ISL
  "phyLayer": [
    {
      "type": "nr",
      // CONFIGURAZIONE CANALI E FDM: Definiamo i Bandwidth Parts (BWP) su più bande
      "channels": [
        // Il canale è un astrazione di una combinazione tra il propagation model, il condition model (canale in LOS o NLOS)
        // E bande organizzate con aggregation (contigui e non) e bandwidth parts (bwps)
        // Nei dispositivi che implementeranno NR ci sarà un netdevice interno per ogni bwp
        {
          // Scenario usato nel modello di propagazione
          // NOTA: Solo il 3GPP propagation model supporta gli scenari NTN
          "scenario": "NTN-Rural",
          // Il condition model è consigliato di default, rispetterà le condizioni probabili dello scenario scelto
          "conditionModel": "Default",
          "propagationModel": "ThreeGpp", // Scelta forzata per scenari NTN
          // Attributi del pathloss (vedere documentazione lena/ns3)
          "pathlossAttributes": [
            {
              "name": "ShadowingEnabled",
              "value": false
            }
          ],
          // Attributi del channel condition (vedere documentazione lena/ns3)
          "channelConditionAttributes": [
            {
              // Aggiorna le condizioni del canale ogni 100ms
              "name": "UpdatePeriod",
              "value": "100ms"
            }
          ],
          // Configurazione delle bande mediante i modelli descritti
          "bands": [
            {
              // Banda 1: Contigua, se non contigua, specificheremo una lista di carriers
              "type": "contiguous",
              "carrier": {
                "centralFrequency": 28e9, // Banda 1
                "bandwidth": 100e6,
                // 1 CC per questa banda
                "numComponentCarriers": 1,
                // 1 BWP per questa banda
                "numBandwidthParts": 1 // BWP 0: Management/Primary
              }
            },
            {
              "type": "contiguous",
              "carrier": {
                "centralFrequency": 28.2e9, // Banda 2 per FDM
                "bandwidth": 100e6,
                "numComponentCarriers": 1,
                // La banda verrà divisa in 2 BWP, uno per il DL e uno per l'UL in questo caso
                "numBandwidthParts": 2 // BWP 1 (DL) e BWP 2 (UL)
              }
            }
          ]
        }
      ],
      // Handover (qui potranno essere inseriti nuovi algoritmi di handover)
      "handover": {
        // Valutazione ideale mediante sinr e distanza per handover
        // In questo algoritmo andiamo a estrarre il nodo UE e gNB coinvolti, e valutiamo in modo ideale la distanza tra i due, e il SINR del link, per decidere se fare handover o meno
        // Usando la threshold di SINR per implementare un meccanismo di isteresi, ed una tabella in cui andiamo a selezionare
        // Il valore minore di distanza tra i massimi di distanze disponibili in DistanceSinrTable, e permettendo il link solo se il SINR è maggiore della soglia (Sintassi: distanza_max1:sinr_min1|distanza_max2:sinr_min2|...)
        "algorithm": "ns3::NrSinrDistanceHandoverAlgorithm",
        "attributes": [
          {
            "name": "DistanceSinrTable",
            "value": "430000:-20.0"
          },
          {
            "name": "Threshold",
            "value": 3.0
          }
        ]
      },
      // Metodo di attach ad inizio simulazione (vedi documentazione del json per altre opzioni)
      "attachMethod": "max-rsrp",
      // IMPOSTAZIONI AVANZATE: attach SINR-Based & Inter-Satellite Links (ISL) Delay
      "advancedOptions": {
        // Configurazione del ritardo per l'ISL simulando le distanze fisiche tra gli apparati inter-satellitari o ai gateway
        "islDelayMode": {
          "precision": "100ms",
          "additionalDelay": "5ms",
          // Distanza massima tra satelliti per l'ISL (entro questa distanza il link è assunto come possibile)
          "maxISLSatDistance": 4000e3,
          // Distanza massima tra satelliti e ground stations per l'ISL (entro questa distanza il link è assunto come possibile)
          "maxGroundStationDistance": 600e3,
          // Lista di ground stations (coordinate geografiche)
          "groundStations": [
            [
              30.0,
              108.0
            ],
            [
              59.0,
              -70.0
            ]
          ],
          // Abilita il log delle path ISL
          "updateLog": true
        }
      },
      // Configurazione dell'EPC (Evolved Packet Core) -> 5G NSA
      "epc": {
        "helper": "ns3::NrPointToPointEpcHelper",
        "attributes": [
          {
            "name": "S1uLinkDelay",
            "value": "0ms"
          }
        ]
      },
      // Configurazione dell'algoritmo di beamforming
      "beamforming": {
        "helper": "ns3::IdealBeamformingHelper",
        "method": "ns3::DirectPathBeamforming",
        "algorithmAttributes": [],
        "attributes": [
          {
            "name": "BeamformingPeriodicity",
            "value": "100ms"
          }
        ]
      },
      // Configurazione dell'antenna del UE (di default)
      "ueAntenna": {
        "arrayProperties": [
          {
            "name": "NumRows",
            "value": 4
          },
          {
            "name": "NumColumns",
            "value": 4
          }
        ]
      },
      // Configurazione dell'antenna del gNB (di default)
      "gnbAntenna": {
        "type": "ns3::CircularApertureAntennaModel",
        "properties": [
          {
            "name": "OperatingFrequency",
            "value": 28e9
          },
          {
            "name": "AntennaMaxGainDb",
            "value": 50.0
          },
          {
            "name": "AntennaCircularApertureRadius",
            "value": 0.01
          }
        ],
        // Proprietà dell'array di antenne (1x1 poichè non vogliamo un array in questo caso)
        "arrayProperties": [
          {
            "name": "NumRows",
            "value": 1
          },
          {
            "name": "NumColumns",
            "value": 1
          }
        ]
      },
      // Configurazione del BWP manager del gNB
      "gnbBwpManager": {
        "attributes": [
          {
            "name": "NGBR_LOW_LAT_EMBB",
            "value": 0
          }
        ]
      },
      // Configurazione del BWP manager del UE
      "ueBwpManager": {
        "attributes": [
          {
            "name": "NGBR_LOW_LAT_EMBB",
            "value": 0
          }
        ]
      },
      // Configurazione dello scheduler
      "scheduler": {
        "type": "ns3::NrMacSchedulerOfdmaPF",
        // In questo esempio fissiamo l'MCS ad un valore fisso ad esempio
        "attributes": [
          {
            "name": "FixedMcsDl",
            "value": true
          },
          {
            "name": "StartingMcsDl",
            "value": 2
          }
        ]
      },
      // Attributi del PHY del UE
      "uePhyAttributes": [
        {
          "name": "TxPower",
          "value": 50.0
        },
        {
          "name": "PowerAllocationType",
          "value": "UniformPowerAllocUsed"
        },
        {
          "name": "EnableUplinkPowerControl",
          "value": false
        },
        {
          "name": "NoiseFigure",
          "value": 0.0
        }
      ],
      // Attributi del PHY del gNB
      "gnbPhyAttributes": [
        {
          "name": "TxPower",
          "value": 50.0
        },
        {
          "name": "NoiseFigure",
          "value": 0.0
        },
        {
          "name": "PowerAllocationType",
          "value": "UniformPowerAllocUsed"
        }
      ]
    }
  ],
  // Sul mac layer va specificato un layer vuoto con solo type nr, non ci sono parametri specificabili poichè tutto è definito in phyLayer
  "macLayer": [
    {
      "type": "nr"
    }
  ],
  // Il network layer non è realmente utilizzato poichè gli IP sono fissati da 5g lena, gli indirizzi sotto sono quelli usati da lena
  // Anche cambiandoli da qui, l'effetto finale sarà nullo
  "networkLayer": [
    {
      "type": "ipv4",
      "address": "7.0.0.0",
      "mask": "255.0.0.0",
      "gateway": "7.0.0.1"
    }
  ],
  // 4. VEICOLI A TERRA (UEs) - MODELLI DI MOBILITÀ MISTI
  "vehicles": [
    // 4.1 Veicolo con movimento esplicito a velocita' costante (Costant Velocity Engine)
    {
      "netDevices": [
        {
          "type": "nr",
          "networkLayer": 0,
          "role": "UE",
          // Specifica del setup del FDM che incrocia i BWP
          "outputLinks": [
            {
              "sourceBwp": 1,
              "targetBwp": 2
            }
          ],
          "bearers": [
            {
              "type": "NGBR_LOW_LAT_EMBB"
            }
          ],
          "directivity": {
            "mode": "serving-gnb"
          }
        }
      ],
      "mobilityModel": {
        "name": "ns3::GeoConstantVelocityMobility",
        "attributes": [
          {
            "name": "InitialLatitude",
            "value": 45.0
          },
          {
            "name": "InitialLongitude",
            "value": 9.0
          },
          {
            "name": "Altitude",
            "value": 0.0
          },
          {
            "name": "Speed",
            "value": 30.0 // Metri al secondo
          },
          {
            "name": "Azimuth", // Angolo di spostamento
            "value": 90.0
          }
        ]
      },
      "applications": [
        {
          "name": "ns3::UdpServer",
          "attributes": [
            {
              "name": "StartTime",
              "value": 0.1
            },
            {
              "name": "StopTime",
              "value": 299.0
            },
            {
              "name": "Port",
              "value": 1234
            }
          ]
        },
        {
          "name": "ns3::UdpClient",
          "attributes": [
            {
              "name": "StartTime",
              "value": 0.2
            },
            {
              "name": "StopTime",
              "value": 299.0
            },
            {
              "name": "Remote",
              "value": {
                "@ip": {
                  "key": "vehicles",
                  "index": 1,
                  "device": 0,
                  "port": 1234
                }
              }
            },
            {
              "name": "MaxPackets",
              "value": 4294967295
            },
            {
              "name": "PacketSize",
              "value": 256
            },
            {
              "name": "Interval",
              "value": 0.005
            }
          ]
        }
      ]
    },
    // 4.2 Veicolo che definisce in modo manuale e diretto le tracce tramite MobilityModel
    {
      "netDevices": [
        {
          "type": "nr",
          "networkLayer": 0,
          "role": "UE",
          "outputLinks": [
            {
              "sourceBwp": 1,
              "targetBwp": 2
            }
          ],
          "bearers": [
            {
              "type": "NGBR_LOW_LAT_EMBB"
            }
          ],
          "directivity": {
            "mode": "serving-gnb"
          }
        }
      ],
      "mobilityModel": {
        // Questo carica una singola traccia definita per un "DeviceId" all'interno della traccia (.trace)
        "name": "ns3::TraceBasedMobilityModel",
        "attributes": [
          {
            "name": "TraceFile",
            "value": "../scenario/assets/taxi_example.trace"
          },
          {
            "name": "DeviceId", // Identificativo interno del veicolo trovato nel file node.csv o races.csv
            "value": "2"
          },
          {
            "name": "Precision",
            "value": "1s"
          }
        ]
      },
      "applications": [
        {
          "name": "ns3::UdpServer",
          "attributes": [
            {
              "name": "StartTime",
              "value": 0.1
            },
            {
              "name": "StopTime",
              "value": 299.0
            },
            {
              "name": "Port",
              "value": 1234
            }
          ]
        },
        {
          "name": "ns3::UdpClient",
          "attributes": [
            {
              "name": "StartTime",
              "value": 0.2
            },
            {
              "name": "StopTime",
              "value": 299.0
            },
            {
              "name": "Remote",
              "value": [
                {
                  "@ip": {
                    "key": "vehicles",
                    "index": 0,
                    "device": 0
                  }
                },
                1234
              ]
            },
            {
              "name": "MaxPackets",
              "value": 4294967295
            },
            {
              "name": "PacketSize",
              "value": 256
            },
            {
              "name": "Interval",
              "value": 0.005
            }
          ]
        }
      ]
    },
    // 4.3 Generazione automatica di MOLTI veicoli (replicazione) mediante la macro !traceMobility
    {
      "netDevices": [
        {
          "type": "nr",
          "networkLayer": 0,
          "role": "UE",
          "outputLinks": [
            {
              "sourceBwp": 1,
              "targetBwp": 2
            }
          ],
          "bearers": [
            {
              "type": "NGBR_LOW_LAT_EMBB"
            }
          ],
          "directivity": {
            "mode": "serving-gnb"
          }
        }
      ],
      // La macro replica dinamicamente per ogni DeviceId esistente nel .trace,
      // un nuovo veicolo copio-incollando i networkDevices o networkLayer in essi inclusi.
      "!traceMobility": {
        "file": "../scenario/assets/taxi_example.trace",
        "blacklist": [
          "2" // we have included this in the privious example manually
        ]
        // blacklist/whitelist e' possibile se serve solo per alcuni DeviceId !
      }
    }
  ],
  // 5. SATELLITI (Loro simulano le Base Station GNB)
  "leo-sats": [
    // 5.1 Definizione di una intera costellazione di satelliti in LEO autogenerati (!constellation)
    {
      // Questo comando instanzia automaticamente `orbits-per-longitude` * `sats-per-orbit` entita'
      "!constellation": {
        "distribution": "uniform-orbits",
        "orbits": [
          {
            "height": 400.0,
            "inclination": 30.0,
            "orbits-per-longitude": 10,
            "sats-per-orbit": 1
          }
        ]
      },
      "netDevices": [
        {
          "type": "nr",
          "networkLayer": 0,
          "role": "gNB",
          "outputLinks": [
            {
              "sourceBwp": 2,
              "targetBwp": 1
            }
          ],
          // Configurazione del setup FDM (Numerology e Pattens)
          "phy": [
            {
              "bwpId": 0,
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 0,
              "name": "Pattern",
              "value": "F|F|F|F|F|F|F|F|F|F|"
            },
            {
              "bwpId": 0,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 1, // Downlink
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 1,
              "name": "Pattern",
              "value": "DL|DL|DL|DL|DL|DL|DL|DL|DL|DL|"
            },
            {
              "bwpId": 1,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 2, // Uplink
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 2,
              "name": "Pattern",
              "value": "UL|UL|UL|UL|UL|UL|UL|UL|UL|UL|"
            },
            {
              "bwpId": 2,
              "name": "TxPower",
              "value": 0.0
            }
          ],
          "directivity": {
            "mode": "earth-centered"
          }
        },
        {
          "type": "nr",
          "networkLayer": 0,
          "role": "gNB",
          "outputLinks": [
            {
              "sourceBwp": 2,
              "targetBwp": 1
            }
          ],
          // Configurazione del setup FDM (Numerology e Pattens)
          "phy": [
            {
              "bwpId": 0,
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 0,
              "name": "Pattern",
              "value": "F|F|F|F|F|F|F|F|F|F|"
            },
            {
              "bwpId": 0,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 1, // Downlink
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 1,
              "name": "Pattern",
              "value": "DL|DL|DL|DL|DL|DL|DL|DL|DL|DL|"
            },
            {
              "bwpId": 1,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 2, // Uplink
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 2,
              "name": "Pattern",
              "value": "UL|UL|UL|UL|UL|UL|UL|UL|UL|UL|"
            },
            {
              "bwpId": 2,
              "name": "TxPower",
              "value": 0.0
            }
          ],
          "directivity": {
            "mode": "earth-centered",
            "downtiltOffset": 0,
            "bearingOffset": 40
          }
        }
      ],
      "applications": []
    },
    // 5.2 Uso diretto e customizzato di un singolo satellite con GeoLeoOrbitMobility invece della macro
    {
      "netDevices": [
        // 1° Netdevice per il beam centrale, vedi in "directivity"
        {
          "type": "nr",
          "networkLayer": 0,
          "role": "gNB",
          // Colleghiamo 2 bwp per uplink e downlink
          "outputLinks": [
            {
              "sourceBwp": 2,
              "targetBwp": 1
            }
          ],
          // Impostazioni custom per il phy layer
          "phy": [
            {
              // Numerology bwp = 0
              "bwpId": 0,
              "name": "Numerology",
              "value": 0
            },
            {
              // Pattern del frame in bwp = 0
              "bwpId": 0,
              "name": "Pattern",
              "value": "F|F|F|F|F|F|F|F|F|F|"
            },
            {
              "bwpId": 0,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 1,
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 1,
              "name": "Pattern",
              "value": "DL|DL|DL|DL|DL|DL|DL|DL|DL|DL|"
            },
            {
              "bwpId": 1,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 2,
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 2,
              "name": "Pattern",
              "value": "UL|UL|UL|UL|UL|UL|UL|UL|UL|UL|"
            },
            {
              "bwpId": 2,
              "name": "TxPower",
              "value": 0.0
            }
          ],
          // Direttività verso il centro terrestre (beam centrato)
          "directivity": {
            "mode": "earth-centered"
          }
        },
        // 2° Net Device per un secondo beam, vedi in "directivity"
        {
          "type": "nr",
          "networkLayer": 0,
          "role": "gNB",
          "outputLinks": [
            {
              "sourceBwp": 2,
              "targetBwp": 1
            }
          ],
          "phy": [
            {
              // Numerology bwp = 0
              "bwpId": 0,
              "name": "Numerology",
              "value": 0
            },
            {
              // Pattern del frame in bwp = 0
              "bwpId": 0,
              "name": "Pattern",
              "value": "F|F|F|F|F|F|F|F|F|F|"
            },
            {
              "bwpId": 0,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 1,
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 1,
              "name": "Pattern",
              "value": "DL|DL|DL|DL|DL|DL|DL|DL|DL|DL|"
            },
            {
              "bwpId": 1,
              "name": "TxPower",
              "value": 4.0
            },
            {
              "bwpId": 2,
              "name": "Numerology",
              "value": 0
            },
            {
              "bwpId": 2,
              "name": "Pattern",
              "value": "UL|UL|UL|UL|UL|UL|UL|UL|UL|UL|"
            },
            {
              "bwpId": 2,
              "name": "TxPower",
              "value": 0.0
            }
          ],
          // Puntiamo sempre al centro della terra, ma rispetto a quella posizione "tiltiamo" la direzione di un certo numero di gradi in elevazione e azimut
          "directivity": {
            "mode": "earth-centered",
            "downtiltOffset": 0,
            "bearingOffset": 40
          }
        }
      ],
