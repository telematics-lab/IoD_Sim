{
  // A five-vehicle ground fleet is served by a three-satellite LEO train at
  // 400 km. The lead satellite carries two beams, so the constellation exposes
  // four NR cells in total; vehicles move through those footprints and are
  // handed over by ns3::NrSinrDistanceHandoverAlgorithm. Every vehicle runs a
  // bidirectional UDP session against the remote host, and satellite-to-ground
  // traffic is delayed by the inter-satellite-link model through a single
  // ground station at 30°N 102°E.
  "name": "log-example",
  "resultsPath": "../results/",
  "logOnFile": true,
  "duration": 60.0,
  "appStatisticsReportInterval": 0.25,
  "staticNs3Config": [
    {
      "name": "ns3::NrUeMac::SrTransMax",
      "value": 1000000
    },
    {
      "name": "ns3::NrRlcUm::MaxTxBufferSize",
      "value": 1048576
    },
    {
      "name": "ns3::GeocentricMobilityModel::EarthSpheroidType",
      "value": "SPHERE"
    },
    {
      "name": "ns3::NrMacSchedulerNs3::EnableHarqReTx",
      "value": true
    },
    {
      "name": "ns3::GeoLeoOrbitMobility::Precision",
      "value": "200ms"
    },
    {
      "name": "ns3::GeoConstantVelocityMobility::Precision",
      "value": "200ms"
    },
    {
      "name": "ns3::ThreeGppChannelModel::UpdatePeriod",
      "value": "200ms"
    },
    {
      "name": "ns3::NrSpectrumPhy::SameNodeInterference",
      "value": false
